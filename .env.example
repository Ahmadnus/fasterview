# ############################################################################
# !! SECURITY REMINDER - ROTATE THE POWER BI CLIENT SECRET !!
#
# The POWERBI_CLIENT_SECRET currently in the local .env was typed out in a
# plain-text chat conversation and must be considered compromised.
#
# TODO: Azure Portal -> App Registrations -> (this app) -> Certificates &
#       secrets -> New client secret -> delete the old one -> update .env.
#
# Never commit a real secret to this file. .env.example holds placeholders only.
# ############################################################################

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=faster_occupancy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Power BI (Service Principal - MSAL Client Credentials Flow)
# Fill these in locally; keep placeholders here.
# ---------------------------------------------------------------------------
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=
POWERBI_API_BASE=https://api.powerbi.com/v1.0/myorg

# Seconds between refresh-status polls, and the overall give-up timeout.
POWERBI_POLL_INTERVAL=60
POWERBI_POLL_TIMEOUT=900

# How many trailing days of raw GA4 daily rows each sync re-pulls into
# `daily_views`. Not an aggregation window — totals are summed at read time.
POWERBI_VIEWS_LOOKBACK_DAYS=30

# Trailing days of per-car-per-day fleet status. Keep above the 90-day UI range.
POWERBI_STATUS_LOOKBACK_DAYS=120

# ---------------------------------------------------------------------------
# Seed accounts (php artisan db:seed --class=UserSeeder)
# Change these and re-seed to rotate the login passwords.
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL=ahmadmog.2091@gmail.com
SEED_OWNER_PASSWORD=
SEED_MANAGER_EMAIL=manager@fastercars.ae
SEED_MANAGER_PASSWORD=

# ---------------------------------------------------------------------------
# Live website catalogue API — authoritative source for rank.
# ---------------------------------------------------------------------------
WEBSITE_CARS_URL=https://www.fastercars.ae/api/cars
WEBSITE_API_TIMEOUT=60
WEBSITE_API_FALLBACK=true
